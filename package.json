    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
