{
  "name": "spec-tacular",
  "version": "0.5.0",
  "description": "A terminal UI for spec-driven development, built on OpenSpec",
  "type": "module",
  "license": "MIT",
  "bin": {
    "spec-tacular": "./src/cli.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
