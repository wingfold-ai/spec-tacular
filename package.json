{
  "name": "spec-tacular",
  "version": "0.7.0",
  "description": "A terminal UI for spec-driven development, built on OpenSpec",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Marius Högger",
  "homepage": "https://spec-tacular.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingfold-ai/spec-tacular.git"
  },
  "bugs": {
    "url": "https://github.com/wingfold-ai/spec-tacular/issues"
  },
  "keywords": [
    "spec-driven-development",
    "openspec",
    "tui",
    "cli",
    "claude-code",
    "opencode",
    "ai-agents",
    "requirements"
  ],
  "bin": {
    "spec-tacular": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.9.6",
    "@opentui/solid": "^0.9.6",
    "solid-js": "^1.9.19",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.1.1",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "zod": "^4.6.6"
  }
}
