{
  "name": "spec-tacular-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm install-script && nuxt dev",
    "build": "pnpm install-script && nuxt build",
    "generate": "pnpm install-script && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "install-script": "cp ../install.sh public/install.sh",
    "shots": "uv run --quiet --with pyte python scripts/tui-shots/capture.py"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.156",
    "@nuxt/content": "3.17.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/ui": "4.12.2",
    "@nuxtjs/seo": "6.0.1",
    "better-sqlite3": "^13.2.0",
    "nuxt": "4.6.4",
    "tailwindcss": "4.3.5"
  }
}
